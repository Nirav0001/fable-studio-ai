# ── Fable Studio AI — Railway environment variables ─────────────────────────
# Set these in the Railway service → Variables tab. DATABASE_URL is provided
# automatically when you add the Postgres plugin (reference it as below).

# Core (REQUIRED)
NODE_ENV=production
AUTH_DEV_BYPASS=false
# 64+ random chars — generate with: openssl rand -hex 32
JWT_SECRET=

# Public URL of THIS Railway service (fill in after the domain is assigned),
# e.g. https://fable-studio-ai-production.up.railway.app
APP_URL=
PUBLIC_URL=

# Database — reference the Postgres plugin:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Persist rendered files across deploys: add a Railway Volume mounted at
# /data, then set:
STORAGE_DIR=/data/storage

# AI providers (same keys you use locally)
AI_PROVIDER=auto
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# YouTube OAuth — add this redirect URI in Google Cloud console:
#   https://<your-railway-domain>/api/v1/oauth/youtube/callback
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Optional
DISCORD_WEBHOOK_URL=
# REDIS_URL=   # leave blank — single instance uses the in-process queue
# STRIPE_SECRET_KEY=
