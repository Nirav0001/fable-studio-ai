# ── Fable Studio AI — environment ─────────────────────────────────────────────
# Copy this file to apps/api/.env  (Prisma + the API server both read it there).
# Every integration is OPTIONAL: leave a key blank and Fable Studio falls back
# to a deterministic mock provider so the whole product still works end-to-end.
# The Settings page shows a live capability matrix from GET /api/v1/health.

# Core
PORT=4100
NODE_ENV=development
APP_URL=http://localhost:3100
API_URL=http://localhost:4100

# Database — sqlite works out of the box; for PostgreSQL run `docker compose up -d`
# then: npm run db:use:postgres  (swaps schema provider) and set:
# DATABASE_URL=postgresql://fable:fable@localhost:5433/fable_studio
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=change-me-in-production-fable-studio
# Dev convenience: unauthenticated requests act as the seeded demo user.
# Set to "false" to require real login (demo@fablestudio.ai / fable-demo-2026).
AUTH_DEV_BYPASS=true

# Queue — leave blank to use the built-in in-memory queue driver.
# For BullMQ + Redis: REDIS_URL=redis://localhost:6379
REDIS_URL=

# AI providers — first configured one wins unless AI_PROVIDER is set
# AI_PROVIDER=openai | anthropic | gemini | mock | auto
AI_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# YouTube OAuth (Google Cloud console → OAuth client, redirect:
#   http://localhost:4100/api/v1/oauth/youtube/callback )
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Stripe (test keys are fine; blank = mock billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_AGENCY=

# Cloudflare R2 (blank = local ./storage on disk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fable-studio
R2_PUBLIC_URL=

# Media tooling
FFMPEG_PATH=ffmpeg
# If yt-dlp is not on PATH, point at the exe (e.g. pip install yt-dlp puts it in
# %LOCALAPPDATA%\Python\pythoncore-3.14-64\Scripts\yt-dlp.exe on Windows)
YTDLP_PATH=yt-dlp

# Notifications
DISCORD_WEBHOOK_URL=
